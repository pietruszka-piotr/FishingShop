@model List<FishingShop.Web.Models.Product>

@{
    ViewData["Title"] = "Strona główna";
}

<section class="home-intro">
    <p class="intro-label">Sprzęt wędkarski</p>
    <h1>Sklep wędkarski działa!</h1>
    <p class="intro-text">Wędki, kołowrotki i przynęty w jednym miejscu.</p>
</section>

<section class="product-catalog" aria-labelledby="products-heading">
    <h2 id="products-heading">Produkty</h2>
    <div class="product-grid">
        @foreach (var product in Model)
        {
            <article class="product-card">
                <div class="product-image-placeholder" aria-hidden="true">Miejsce na zdjęcie</div>
                <h3><a class="product-link" href="@Url.Action("Details", "Home", new { id = product.Id })">@product.Name</a></h3>
                <p>@product.Description</p>
                <p class="product-price">@product.Price.ToString("C2", System.Globalization.CultureInfo.GetCultureInfo("pl-PL"))</p>
            </article>
        }
    </div>
</section>
