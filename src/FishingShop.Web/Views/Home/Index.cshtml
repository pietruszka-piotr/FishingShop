@model FishingShop.Web.Models.Product

@{
    ViewData["Title"] = "Strona główna";
}

<section class="home-intro">
    <p class="intro-label">Sprzęt wędkarski</p>
    <h1>Sklep wędkarski działa!</h1>
    <p class="intro-text">Wędki, kołowrotki i przynęty w jednym miejscu.</p>
</section>

<section class="featured-product" aria-labelledby="featured-product-heading">
    <h2 id="featured-product-heading">Przykładowy produkt</h2>
    <article class="product-card">
        <h3>@Model.Name</h3>
        <p>@Model.Description</p>
        <p class="product-price">@Model.Price.ToString("C2", System.Globalization.CultureInfo.GetCultureInfo("pl-PL"))</p>
    </article>
</section>
